# Web POS (Vite). Copy to web/.env for local development.

# Dev only: the Laravel API the Vite dev server proxies /api and /storage to.
# The browser always talks to its own origin (no CORS); in production the app
# is served by Laravel at /pos, so this key is not used by `npm run build`.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional (Q-038): the origin of an external image disk (e.g. an S3-compatible bucket),
# e.g. https://images.example.com. Empty: images are served from this server's /storage.
# When set, `npm run build` adds it to the CSP img-src.
VITE_IMAGE_ORIGIN=
