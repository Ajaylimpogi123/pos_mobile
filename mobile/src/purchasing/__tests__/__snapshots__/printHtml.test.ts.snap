</thead><tbody><tr><td class="tabular">1</td><td>Flour</td><td class="num">2</td><td>sack</td><td class="num">₱1,200.00</td><td class="num">₱500.00</td><td class="num">0</td><td class="num">2</td></tr></tbody></table><div class="totals avoid"><div class="row"><span>Subtotal · Bakery Supply Co</span><span class="tabular">₱500.00</span></div></div></section><div class="totals avoid"><div class="row strong"><span>Grand total</span><span class="tabular">₱2,900.00</span></div></div><div class="signatures avoid" style="grid-template-columns:repeat(3,minmax(0,1fr))"><div class="sign"><p class="role">Prepared by</p><div class="line"></div><p class="name">Mia Manager</p><p class="hint">Signature over printed name</p><div class="line date"></div><p class="hint">Date</p></div><div class="sign"><p class="role">Approved by</p><div class="line"></div><p class="name">Owen Owner</p><p class="hint">Signature over printed name</p><div class="line date"></div><p class="hint">Date</p></div><div class="sign"><p class="role">Received by</p><div class="line"></div><p class="name"></p><p class="hint">Signature over printed name</p><div class="line date"></div><p class="hint">Date</p></div></div><p class="doc-footer">Printed 12 Oct 2026, 3:04 PM by Ana · PO-MAIN-2026-00001</p></article>
