APP_NAME="POS Mobile"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Lifetime (hours) of the device-bound token issued by POST /api/v1/auth/login
AUTH_TOKEN_TTL_HOURS=24

# Filesystem disk for category and product images (public in dev, an S3-compatible disk in production)
CATALOG_IMAGE_DISK=public

# Local dev only: when set (e.g. this PC's LAN IP running `npm run fake-printer` in mobile/),
# DevSeeder adds the Counter (9100), Kitchen (9101) and Bar (9102) printers at this host.
# Leave empty to seed no printers.
DEV_PRINTER_HOST=

# Web POS print agent. Server: the shared secret (empty → /api/v1/print-agent/* answers 503)
# and the branch it serves. Agent PC (`php artisan print-agent:run`): the API origin, the same
# secret, and the agent's name (empty → the hostname).
PRINT_AGENT_TOKEN=
PRINT_AGENT_BRANCH_ID=1
PRINT_AGENT_API_URL=
PRINT_AGENT_ID=

# App versions (Hardening & Pilot → C): semver major.minor.patch; the update link may be empty.
APP_MIN_VERSION=1.0.0
APP_LATEST_VERSION=1.0.0
APP_UPDATE_URL=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pos_mobile
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
